# 复制为 .env（或写进 systemd 的 EnvironmentFile）后按需修改。.env 已在 .gitignore 里，不会被提交。

# 数据接口的地址和 Key。不随源码提供，联系作者获取，获取方式见 README。
# 也可以留空，登录后在「管理后台 → 系统设置」里填。
DATA_API_BASE=
DATA_API_KEY=

# 用来加密数据库里客户阿里云 Key 的主密钥，和数据库分开保存。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 一旦用了就不要改，改了之前保存的客户 Key 会解不开。
HUOKE_SECRET=

# 部署在 gunicorn + 反向代理 + HTTPS 后面时打开（本地直接 python app.py 不需要）
# HUOKE_SCHEDULER=1     启动后台定时任务（对标账号自动刷新、续跑视频任务），gunicorn 只能开 1 个 worker
# HUOKE_BEHIND_PROXY=1  信任反向代理传来的真实 IP / 协议
# HUOKE_HTTPS=1         登录 cookie 加 Secure
